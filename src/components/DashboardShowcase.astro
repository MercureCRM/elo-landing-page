---
---

<section class="py-section-gap px-6 bg-surface relative z-0 overflow-hidden">
	<span class="material-symbols-outlined text-[180px] text-primary/5 absolute -left-20 top-1/4 animate-float-slow -z-10" style="font-variation-settings: 'FILL' 1;">chat_bubble</span>
	<span class="material-symbols-outlined text-[140px] text-action-emerald/5 absolute -right-10 bottom-1/3 animate-float-medium -z-10" style="font-variation-settings: 'FILL' 1;">sms</span>
	<div class="absolute -right-20 top-1/3 w-[700px] h-[600px] bg-primary/5 rounded-[6rem] rounded-tr-none -z-10 rotate-3"></div>
	<div class="absolute top-0 right-0 w-[800px] h-[800px] bg-secondary-container/10 rounded-full blur-[120px] -z-10"></div>

	<!-- Floating Decorative Elements -->
	<span class="material-symbols-outlined text-[80px] text-secondary/10 absolute top-[15%] left-[8%] animate-float-medium -z-10" style="font-variation-settings: 'FILL' 1;">insights</span>
	<span class="material-symbols-outlined text-[64px] text-action-emerald/10 absolute bottom-[25%] right-[5%] animate-float-slow -z-10" style="font-variation-settings: 'FILL' 1;">add_comment</span>

	<div class="max-w-[1440px] mx-auto relative z-10">
		<div class="text-center mb-20">
			<h2 class="font-headline-xl text-headline-xl text-on-surface mb-6">Controle total em suas mãos</h2>
			<p class="font-body-lg text-body-lg text-on-surface-variant max-w-3xl mx-auto">Um painel limpo e direto ao ponto, projetado para que você foque no seu negócio, não em aprender a usar a ferramenta.</p>
		</div>

		<div class="relative mx-auto max-w-[1200px]">
			<!-- Decorative background elements -->
			<div class="absolute -inset-8 bg-gradient-to-br from-primary/20 via-secondary-container/20 to-primary/10 rounded-[3rem] blur-2xl -z-10"></div>
			<!-- Browser Window Mockup -->
			<div class="bg-surface-container-lowest rounded-[2rem] shadow-[0_40px_100px_rgba(15,82,56,0.2)] border border-outline-variant/30 overflow-hidden flex flex-col transform hover:-translate-y-2 transition-transform duration-500">
				<!-- Browser Header -->
				<div class="bg-surface-container-high px-6 py-4 flex items-center gap-4 border-b border-outline-variant/30">
					<div class="flex gap-2.5">
						<div class="w-4 h-4 rounded-full bg-error/90 shadow-inner"></div>
						<div class="w-4 h-4 rounded-full bg-[#F5B041]/90 shadow-inner"></div>
						<div class="w-4 h-4 rounded-full bg-action-emerald/90 shadow-inner"></div>
					</div>
					<div class="mx-auto bg-surface-container-lowest px-8 py-2 rounded-full text-sm text-on-surface-variant font-mono flex items-center gap-3 border border-outline-variant/30 shadow-sm w-full max-w-xl justify-center font-bold">
						<span class="material-symbols-outlined text-[18px]">lock</span> mercure-elo.com
					</div>
					<div class="w-16"></div> <!-- Spacer for balance -->
				</div>
				<!-- Browser Content -->
				<div class="relative bg-surface p-0">
					<img alt="Painel principal do Mércure Elo" class="w-full h-auto object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuA1yDBJ5vTGgzSlXCsQdHPFMdwzNzcuH4Ytkld6IfLPbH12GQUBStUu97xlCmSYFqRFFLLyE94z2IJgUWwsvPemI_8zntSRQ4h7tRirsEl9-XB73FnJSVgvisbvtORUv4JQqeh2VnzGTtJmqTDifk5xpsXYyHpcV5gf3ZjShgZPqpKVzApcFDAjFKHdQBs7BBgHctpCFwSiTpJ8ajU0rFAWrC5dnSL_MGOfQ_lLew7xVAyt3HmND7cZrgP861DbNdmR">
				</div>
			</div>
		</div>

		<div class="mt-24 text-center">
			<button class="bg-primary text-pure-white hover:bg-primary-container active:scale-95 transition-all duration-300 rounded-full px-12 py-6 font-headline-md text-headline-md shadow-[0_15px_40px_rgba(15,82,56,0.3)] hover:shadow-[0_20px_50px_rgba(15,82,56,0.4)] inline-flex items-center justify-center gap-4">
				Criar Minha Primeira Campanha
				<span class="material-symbols-outlined text-[32px]">arrow_forward</span>
			</button>
		</div>
	</div>
</section>
